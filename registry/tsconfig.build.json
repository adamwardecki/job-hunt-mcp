{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "typeRoots": ["../dev/node_modules/@types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "newLine": "lf",
    "noEmitOnError": true,
    "rootDir": "../plugin/servers/tracker/src",
    "outDir": "../dist/server-js"
  },
  "include": ["../plugin/servers/tracker/src/**/*.ts"]
}
